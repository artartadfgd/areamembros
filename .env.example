# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Nunca exponha esta chave no client. Só é usada em rotas de servidor
# (webhook da Hotmart, verificação de login por e-mail).
SUPABASE_SERVICE_ROLE_KEY=

# Hotmart — usado para validar que os webhooks recebidos em
# /api/webhooks/hotmart realmente vêm da Hotmart (Hottok).
HOTMART_WEBHOOK_TOKEN=

# Segredo usado para assinar o cookie de sessão do login por e-mail.
SESSION_SECRET=
