# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Never expose this on the client. Only used in server code (Hotmart
# webhook, email-login check, admin panel).
SUPABASE_SERVICE_ROLE_KEY=

# Hotmart — used to check that webhooks received at
# /api/webhooks/hotmart really come from Hotmart (the "Hottok" value
# shown in your product's webhook settings on Hotmart).
HOTMART_WEBHOOK_TOKEN=

# Hotmart API (optional but recommended) — lets login fall back to
# asking Hotmart directly when there's no local purchase record yet
# (covers purchases made before the webhook was set up, or a missed
# webhook delivery). From Hotmart: Tools > Developer Tools > Credentials
# > create a new credential set.
HOTMART_CLIENT_ID=
HOTMART_CLIENT_SECRET=
HOTMART_BASIC_TOKEN=

# Secret used to sign the session cookies (customer login + admin
# panel). Generate one with: openssl rand -base64 32
SESSION_SECRET=

# Password for the /admin panel (just you — no separate admin login
# system). Pick something long and random.
ADMIN_PASSWORD=
